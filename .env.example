# Deployment
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_BASE_URL=https://bot.example.com
CSRF_TRUSTED_ORIGINS=https://bot.example.com

# Database
POSTGRES_DB=binodex_bot
POSTGRES_USER=binodex
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://binodex:change-me@db:5432/binodex_bot

# Telegram / partner identity. Deploy a separate .env for every partner bot.
TELEGRAM_BOT_TOKEN=
BOT_NAME=Binodex Partner Bot
SUPPORT_URL=https://t.me/your_support
PARTNER_REF_CODE=

# Broker API. Create the client in BinoPartner → Broker API before filling these.
BROKER_CLIENT_ID=
BROKER_CLIENT_SECRET=
BROKER_API_URL=https://api.binodex.app/v1
BROKER_WS_URL=https://broker-ws.binodex.app
BROKER_PLATFORM_URL=https://binodex.app

# Used only on this server to encrypt OAuth tokens at rest.
TOKEN_ENCRYPTION_SECRET=replace-with-a-separate-long-random-secret

